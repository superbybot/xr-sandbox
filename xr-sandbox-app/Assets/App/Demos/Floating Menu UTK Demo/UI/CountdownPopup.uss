.countdown-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0); /* Transparent background */
    width: 1024px;
    height: 1024px;
}

.countdown-text {
    font-size: 500px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 10px;
    -unity-text-outline-color: black;
    -unity-text-align: middle-center;
    transition-property: scale, opacity;
    transition-duration: 0.2s;
}

/* Specific colors for counts */
.count-3 { color: #FF4D4D; }
.count-2 { color: #FFB732; }
.count-1 { color: #A8E05F; }
.count-go { color: #00FF00; font-size: 300px; }
